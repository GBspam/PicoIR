.program picoir_ir_tx_carrier
; Input word: bit 31 = carrier enabled, bits 30:0 = carrier periods - 1.
; Each active period is five state-machine cycles: two high, two low, one jump.
; Inactive periods use the same cadence with the output low.
; Fixed per-segment overhead means this is not a calibrated production engine.
.wrap_target
start:
    pull block
    out y, 1
    out x, 31
    jmp !y inactive
active:
    set pins, 1 [1]
    set pins, 0 [1]
    jmp x-- active
    jmp start
inactive:
    set pins, 0
    nop [2]
    jmp x-- inactive
    jmp start
.wrap
